{
  "name": "saasfood",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @saasfood/web dev",
    "build": "pnpm --filter @saasfood/web build",
    "start": "pnpm --filter @saasfood/web start",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @saasfood/db generate",
    "db:migrate": "pnpm --filter @saasfood/db migrate",
    "db:seed": "pnpm --filter @saasfood/db seed"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9"
}
